# =============================================================================
# GEMSTREAM — Environment Variables Template
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# ── DATABASE ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://gemstream:CHANGE_ME@localhost:5432/gemstream?schema=public"

# ── STRIPE (Fiat On-Ramp) ───────────────────────────────────────────────────
# API secret key — starts with sk_live_ (production) or sk_test_ (sandbox)
STRIPE_SECRET_KEY="sk_test_CHANGE_ME"

# Webhook endpoint signing secret — starts with whsec_
STRIPE_WEBHOOK_SECRET="whsec_CHANGE_ME"

# ── POLYGON / CRYPTO (Off-Ramp) ─────────────────────────────────────────────
# JSON-RPC endpoint for Polygon PoS
# Production: https://polygon-rpc.com or an Alchemy/Infura URL
# Testnet (Amoy): https://rpc-amoy.polygon.technology
POLYGON_RPC_URL="https://polygon-rpc.com"

# Platform hot-wallet private key (0x-prefixed 32-byte hex)
# THIS IS THE MOST SENSITIVE VALUE IN THE ENTIRE SYSTEM
HOT_WALLET_PRIVATE_KEY="0xCHANGE_ME"

# ── APPLICATION ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed Socket.io origins (dashboard + OBS overlay)
ALLOWED_ORIGINS="https://stream.irjavid.org"

# Dashboard frontend origin — sole allowed REST API CORS origin (strict)
DASHBOARD_ORIGIN="https://stream.irjavid.org"

# HS256 signing secret — minimum 32 characters; rotate in production
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_STRING_AT_LEAST_32_CHARS"

# Server port (defaults to 3000 if omitted in env schema; production uses 9234)
PORT=9234

# ── INTEGRATION TESTS ────────────────────────────────────────────────────────
# Isolated PostgreSQL database for Jest integration tests (npm run test:integration)
TEST_DATABASE_URL="postgresql://gemstream:gemstream@127.0.0.1:5432/gemstream_test?schema=public"

# ── NODE ENVIRONMENT ─────────────────────────────────────────────────────────
NODE_ENV="production"
