{
  "name": "gemstream",
  "version": "1.0.0",
  "description": "Crypto-bridge tipping engine — Stripe fiat to Polygon USDT payouts",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
