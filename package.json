    "db:studio": "prisma studio",
    "test": "jest --verbose",
    "test:integration": "jest --verbose tests/donation.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "@types/jsonwebtoken": "^9.0.10",
    "dotenv": "^17.4.2",
    "ethers": "^6.13.0",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.21.0",
    "socket.io": "^4.8.0",
    "stripe": "^17.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^7.2.0",
    "jest": "^29.7.0",
    "prisma": "^6.9.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
