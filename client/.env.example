# Copy to .env.local and adjust for your environment.
#
# Production (Caddy: /api → backend, /socket.io → backend, /* → frontend).
# Caddy listens on port 2053 — it MUST be included here. If you omit it,
# NEXT_PUBLIC_SOCKET_URL/NEXT_PUBLIC_API_URL take priority over any fallback
# in client/lib/urls.ts, silently dropping the port and breaking the socket.
NEXT_PUBLIC_API_URL=https://stream.irjavid.org:2053/api
NEXT_PUBLIC_SOCKET_URL=https://stream.irjavid.org:2053
#
# Local development (no Caddy):
# NEXT_PUBLIC_API_URL=http://localhost:9234
# NEXT_PUBLIC_SOCKET_URL=http://localhost:9234
